{
	"schemaVersion": 1,
	"id": "imyvm-announce-lite",
	"version": "${version}",
	"name": "ImyvmAnnounceLite",
	"description": "A lite mod to send motd-formatted announcement for imyvm-server.",
	"authors": [
		"Doohaey Re"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "GPL-3",
	"icon": "assets/imyvm-announce-lite/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.imyvm.ial.ImyvmAnnounceLite",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"imyvm-announce-lite.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}